#!/usr/bin/env python3
"""Generates Cod's app icons from the approved master and checks them (issue #57).

The master is the approved 1024x1024 RGBA app icon with its transparent platform padding.
Every derived icon is a Lanczos downscale of the master (or a byte copy at 1024 px), packed into PNG or ICO.
Nothing is redrawn, recolored, cropped or flattened: the alpha channel is kept.

Usage (Pillow from script/cod-app-icons-requirements.txt, in a virtual environment):
  script/cod-app-icons --master <path to cod-logo-1024.png>   copy the master into the repo, then generate
  script/cod-app-icons                                        generate from the master already in the repo
  script/cod-app-icons --check                                fail if a committed icon differs from a fresh run
  script/cod-app-icons --contact-sheet <out.png>              write a contact sheet of the derived sizes
"""

import argparse
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile

from PIL import Image, ImageDraw

MASTER_SHA256 = "bb82c4ce6cc59e896861a6813d114b26c2b1eb9d7735169420017e45997a65f3"
MASTER = "crates/zed/resources/cod-app-icon-1024.png"
CHANNELS = ["", "-dev", "-nightly", "-preview"]
HICOLOR_SIZES = [16, 32, 48, 64, 128, 256, 512, 1024]
ICO_SIZES = [16, 24, 32, 48, 64, 128, 256]

# SHA-256 of the predecessor (Zed) icons this script replaced. None of them may remain in the tree,
# except in the files listed in PREDECESSOR_ALLOWED.
PREDECESSOR_SHA256 = {
    "113ef50d1d7f5dfddf5c0fc00592da449043c3b0ace3f6f68c80c134b816e9bc": "crates/zed/resources/app-icon@2x.png",
    "6cdab76f01bcc6a03fe7d974fce7bf9458d449f04632e2b1157523a69f461632": "crates/zed/resources/app-icon-dev@2x.png",
    "57f2f915e1fe4b4643dc4a949ad2bcd94617ec04c63ea2ba44d108c2d2f07633": "crates/zed/resources/app-icon-dev.png",
    "a4e05e232ec4c12ac0accc0d128639260d54f4eb242ae425135a4f736a9c6326": "crates/zed/resources/app-icon-nightly@2x.png",
    "60d33241d9c652046d52eaf2c6ee32360990ed27da13c47dfdc0eacba2a13f75": "crates/zed/resources/app-icon-nightly.png",
    "77453d98d46494b3b34b94aa863b686ea299e0190030a5c7ca5377b238332522": "crates/zed/resources/app-icon.png",
    "d8f0f893329153cc22ada754fb2dfb3767d91ea2257e9686a8f9bbc3752b87fe": "crates/zed/resources/app-icon-preview@2x.png",
    "a7c1364b28f3d5cc34e9c23e9fc20546208c2042b512d0eb3b57c467156ec6f2": "crates/zed/resources/app-icon-preview.png",
    "7b67e2ddc4a1f8118af5549a5e6a119240d586c22d851bb780be3c7286a07cc9": "crates/zed/resources/windows/app-icon-dev.ico",
    "ce493d2d743044f7e2b7eeab8f6f0fa06d6c68e8079578c697de3e41f29d41e0": "crates/zed/resources/windows/app-icon.ico",
    "fd5a775978da796fbcee1f476b0182419346d0dd4cc8da7e41c19a12e300b346": "crates/zed/resources/windows/app-icon-nightly.ico",
    "bda29ec126ac69d4604590b6cf30ee46af54631a8f0ee45d649ee6ce27caec07": "crates/zed/resources/windows/app-icon-preview.ico",
    "1b548de4063e0d3a8da7bfe3066bd8009a621b940a6a99c3c02c04fef8bf8424": "crates/auto_update_helper/app-icon.ico",
}

# A GPUI example image (a test fixture of the upstream UI framework, never shipped in Cod).
PREDECESSOR_ALLOWED = {"crates/gpui/examples/image/app-icon.png"}


def png_outputs():
    """Maps each derived PNG path to its pixel size."""
    outputs = {}
    for channel in CHANNELS:
        outputs[f"crates/zed/resources/app-icon{channel}.png"] = 512
        outputs[f"crates/zed/resources/app-icon{channel}@2x.png"] = 1024
    for size in HICOLOR_SIZES:
        outputs[f"crates/zed/resources/linux/hicolor/{size}x{size}/apps/cod.png"] = size
    return outputs


def ico_outputs():
    paths = [f"crates/zed/resources/windows/app-icon{channel}.ico" for channel in CHANNELS]
    paths.append("crates/auto_update_helper/app-icon.ico")
    return paths


def sha256(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def fail(message):
    print(f"cod-app-icons: {message}", file=sys.stderr)
    sys.exit(1)


def load_master(root):
    path = os.path.join(root, MASTER)
    if sha256(path) != MASTER_SHA256:
        fail(f"{MASTER} does not have the approved SHA-256 {MASTER_SHA256}")
    image = Image.open(path)
    image.load()
    if image.size != (1024, 1024) or image.mode != "RGBA":
        fail(f"{MASTER} must be 1024x1024 RGBA, it is {image.size} {image.mode}")
    return image


def resample(master, size):
    if size == master.size[0]:
        return master.copy()
    return master.resize((size, size), Image.Resampling.LANCZOS, reducing_gap=None)


def generate(root, out):
    """Writes every derived icon under `out`, read from the master under `root`."""
    master = load_master(root)
    for path, size in png_outputs().items():
        target = os.path.join(out, path)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        if size == 1024:
            # The 1024 px icons are the master itself, byte for byte.
            shutil.copyfile(os.path.join(root, MASTER), target)
        else:
            resample(master, size).save(target, format="PNG")
    frames = [resample(master, size) for size in ICO_SIZES]
    for path in ico_outputs():
        target = os.path.join(out, path)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        # The largest frame is the base image and the others are given ready-made, so Pillow resizes nothing itself.
        frames[-1].save(
            target,
            format="ICO",
            sizes=[(size, size) for size in ICO_SIZES],
            append_images=frames[:-1],
        )


def frames_of(path):
    """Returns [(width, height, mode, pixel bytes)] for a PNG or each entry of an ICO."""
    image = Image.open(path)
    if image.format == "ICO":
        result = []
        for size in sorted(image.info["sizes"]):
            frame = image.ico.getimage(size)
            result.append((frame.size[0], frame.size[1], frame.mode, frame.tobytes()))
        return result
    image.load()
    return [(image.size[0], image.size[1], image.mode, image.tobytes())]


def check_frame(path, width, height, mode, pixels):
    if mode != "RGBA":
        fail(f"{path}: a {width}px image is {mode}, not RGBA")
    image = Image.frombytes(mode, (width, height), pixels)
    alpha = image.getchannel("A")
    # The master's transparent margin must survive: every corner is transparent, the middle is opaque.
    for corner in [(0, 0), (width - 1, 0), (0, height - 1), (width - 1, height - 1)]:
        if alpha.getpixel(corner) != 0:
            fail(f"{path}: the {width}px corner {corner} is not transparent")
    if alpha.getpixel((width // 2, height // 2)) != 255:
        fail(f"{path}: the {width}px center is not opaque")


def check(root):
    load_master(root)
    print(f"ok  {MASTER} sha256 {MASTER_SHA256}")
    with tempfile.TemporaryDirectory() as fresh:
        generate(root, fresh)
        expected_paths = list(png_outputs().items()) + [(path, None) for path in ico_outputs()]
        for path, size in expected_paths:
            committed = os.path.join(root, path)
            if not os.path.exists(committed):
                fail(f"{path} is missing; run script/cod-app-icons")
            have = frames_of(committed)
            want = frames_of(os.path.join(fresh, path))
            if have != want:
                fail(f"{path} differs from a fresh run of script/cod-app-icons")
            if size is None and [f[0] for f in have] != ICO_SIZES:
                fail(f"{path} has entries {[f[0] for f in have]}, expected {ICO_SIZES}")
            if size is not None and (have[0][0], have[0][1]) != (size, size):
                fail(f"{path} is {have[0][0]}x{have[0][1]}, expected {size}x{size}")
            if size == 1024 and sha256(committed) != MASTER_SHA256:
                fail(f"{path} is not a byte copy of the master")
            for frame in have:
                check_frame(path, *frame)
            sizes = ",".join(str(f[0]) for f in have)
            print(f"ok  {path} [{sizes}] sha256 {sha256(committed)}")
    tracked = subprocess.run(
        ["git", "ls-files", "-z"], cwd=root, check=True, capture_output=True
    ).stdout.decode().split("\0")
    stale = []
    for path in tracked:
        if not path or not path.lower().endswith((".png", ".ico", ".icns", ".jpg", ".jpeg", ".bmp")):
            continue
        full = os.path.join(root, path)
        if not os.path.isfile(full):
            continue
        digest = sha256(full)
        if digest in PREDECESSOR_SHA256 and path not in PREDECESSOR_ALLOWED:
            stale.append(f"{path} (was {PREDECESSOR_SHA256[digest]})")
    if stale:
        fail("predecessor icons remain: " + ", ".join(stale))
    print(f"ok  no predecessor icon among {len(tracked)} tracked files (allowed: {', '.join(sorted(PREDECESSOR_ALLOWED))})")


def contact_sheet(root, out):
    """Draws each derived size at 1:1, and 32 and 16 px also at 8x nearest neighbor, on light and dark."""
    images = [(size, Image.open(os.path.join(root, f"crates/zed/resources/linux/hicolor/{size}x{size}/apps/cod.png")).convert("RGBA"))
              for size in [1024, 512, 256, 128, 64, 32, 16]]
    magnified = [(size, image.resize((size * 8, size * 8), Image.Resampling.NEAREST)) for size, image in images if size in (32, 16)]
    gap = 24
    label = 20
    row_width = sum(image.size[0] for _, image in images) + gap * (len(images) + 1)
    mag_width = sum(image.size[0] for _, image in magnified) + gap * (len(magnified) + 1)
    panel_height = gap + label + 1024 + gap + label + 256 + gap
    width = max(row_width, mag_width)
    sheet = Image.new("RGBA", (width, panel_height * 2), (0, 0, 0, 255))
    for index, (background, ink) in enumerate([((245, 245, 245, 255), (40, 40, 40, 255)), ((30, 30, 30, 255), (220, 220, 220, 255))]):
        top = index * panel_height
        panel = Image.new("RGBA", (width, panel_height), background)
        draw = ImageDraw.Draw(panel)
        x = gap
        for size, image in images:
            draw.text((x, gap), f"{size} px", fill=ink)
            panel.alpha_composite(image, (x, gap + label))
            x += image.size[0] + gap
        x = gap
        y = gap + label + 1024 + gap
        for size, image in magnified:
            draw.text((x, y), f"{size} px at 8x (nearest)", fill=ink)
            panel.alpha_composite(image, (x, y + label))
            x += image.size[0] + gap
        sheet.alpha_composite(panel, (0, top))
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    sheet.convert("RGB").save(out, format="PNG")
    print(f"wrote {out} ({sheet.size[0]}x{sheet.size[1]})")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--master", help="copy this approved master into the repo first")
    parser.add_argument("--check", action="store_true", help="check the committed icons instead of writing them")
    parser.add_argument("--contact-sheet", metavar="PNG", help="write a contact sheet of the derived icons")
    args = parser.parse_args()
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if args.master:
        if sha256(args.master) != MASTER_SHA256:
            fail(f"{args.master} does not have the approved SHA-256 {MASTER_SHA256}")
        shutil.copyfile(args.master, os.path.join(root, MASTER))
    if args.check:
        check(root)
    elif args.contact_sheet is None or args.master:
        generate(root, root)
        print("generated the icons from " + MASTER)
    if args.contact_sheet:
        contact_sheet(root, args.contact_sheet)


if __name__ == "__main__":
    main()
